{
  "name": "quran-reader",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "prepare:electron": "node scripts/build-electron-updater.cjs && node scripts/prepare-electron.mjs",
    "electron:dev": "npm run build && npm run prepare:electron && electron .",
    "dist:win": "npm run build && npm run prepare:electron && npm run verify:portable-key && electron-builder --config electron-builder.yml --win",
    "verify:data": "node scripts/verify-data.mjs",
    "check": "npm run verify:data && npm run test:quran-text && npm run test:electron-security && npm run typecheck && npm run lint && npm run build",
    "generate:portable-keys": "node scripts/generate-portable-update-keys.cjs",
    "verify:portable-key": "node scripts/verify-portable-update-key.cjs",
    "create:portable-manifest": "node scripts/create-portable-update-manifest.cjs",
    "test:quran-text": "python -m unittest discover -s tools -p \"test_*.py\"",
    "test:electron-security": "node --test scripts/test-electron-security.cjs",
    "refresh:dependencies": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/refresh-dependencies.ps1"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/vazirmatn": "^5.3.0",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.1",
    "electron-updater": "^6.8.12",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8"
  },
  "description": "Quran Reader Lite: Arabic Quran text, offline reading and search for Windows desktop.",
  "repository": {
    "type": "git",
    "url": "https://github.com/mediadesign853-cpu/quran-lite.git"
  },
  "main": "electron/main.cjs",
  "author": "Quran Reader",
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10.0.0"
  }
}
